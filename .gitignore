# Секреты — никогда не коммитить
.env

# Виртуальное окружение и кэш
venv/
.venv/
__pycache__/
*.py[cod]

# Редакторы и ОС
.vscode/
.idea/
.DS_Store
Thumbs.db

# Скриншоты диалога и настроек не входят в репозиторий: они прикладываются отдельно.
# README.md и mock-dialog.txt из этой папки, наоборот, коммитятся.
screenshots/*
!screenshots/README.md
!screenshots/mock-dialog.txt
